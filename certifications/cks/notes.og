** aquasec tracee
- observe sys calls from containers
- relies on ebpf
- run tracee as a docker container
- Bind mounts
  - /tmp/tracee (default workspace)
  - /lib/modules (kernel headers)
  - /usr/src (kernel headers)
- capabilities
  - privileged
#+begin_src bash

  # use tracee to trace ls command
  docker run --name tracee --rm --privileged --pid=host \
       -v /lib/modules:/lib/modules:ro -v /usr/src:/usr/src:ro \
       -v /tmp/tracee:/tmp/tracee aquasec/tracee:0.4.0 --trace comm=ls

  # run tracee as a docker container to observe sys calls for all new processes on the host
  sudo docker run --name tracee --rm --privileged --pid=host \
       -v /lib/modules:/lib/modules:ro -v /usr/src:/usr/src:ro \
       -v /tmp/tracee:/tmp/tracee aquasec/tracee:0.4.0 --trace pid=new

  # run tracee as a docker container to observe sys calls for all new containers on the host
  sudo docker run --name tracee --rm --privileged --pid=host \
       -v /lib/modules:/lib/modules:ro -v /usr/src:/usr/src:ro \
       -v /tmp/tracee:/tmp/tracee aquasec/tracee:0.4.0 --trace container=new
#+end_src
    
