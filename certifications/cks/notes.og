#+begin_src bash
  # install cilium
  # Add the Cilium Helm repository
  helm repo add cilium https://helm.cilium.io/

  # Install Cilium with encryption enabled
  helm install cilium cilium/cilium --version v1.18.0-pre.0 \
       --namespace kube-system \
       --set encryption.enabled=true \
       --set encryption.type=wireguard
#+end_src
* supply chain security
** sbom
- comprehensive inventory of all components, libraries, and modules within a piece of software.
** SBOM formats
#+begin_src shell
  # install syft
  curl -sSfL <install.sh url> | sh

  curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin

  # generate sbom for image
  syft image:tag -o spdx-json
  syft docker.io/kodekloud/webapp-color:latest -o spdx=/root/webapp-spdx.sbom
  syft docker.io/kodekloud/webapp-color:latest -o cyclonedx-json=/root/webapp-sbom.json

  # generate sbom for source code
  syft /path/to/src/code -o spdx-json

  # install grype
  curl -sSfL <install.sh url> | sh
  curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin

  # grype sbom scan
  grype sbom:nginx-sbom.cyclonedx.json

  #find all critical vulnerabilities
  jq -r '[.matches[] | select(.vulnerability.severity == "Critical")] | length' /root/grype-report.json
#+end_src
