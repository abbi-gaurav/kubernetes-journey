** TLS
** TLS in k8s
#+begin_src bash
  # generate a new ca.key
  openssl genrsa -out ca.key 2048

  # generate a csr for ca
  openssl req -new -key ca.key -subj "/CN=KUBERNETES-CA" -out ca.csr

  # self sign the ca csr
  openssl x509 -req -in ca.csr -signkey ca.key -out ca.crt

  # generare admin key and get the certificate signed
  openssl genrsa -out admin.key 2048
  openssl req -new -key admin.key -subj "/CN=kube-admin" -out admin.csr
  openssl x509 -req -in admin.csr -CA ca.crt -CAkey ca.key -out admin.crt

  # generate the scheduler certifixate and key
  openssl genrsa -out scheduler.key 2048
  openssl req -new -key scheduler.key -subj "/CN=system:kube-scheduler" -out scheduler.csr
  openssl x509 -req -in scheduler.csr -CA ca.crt -CAkey ca.key -out scheduler.crt

  # generate apiserver key and certificat
  openssl genrsa -out apiserver.key 2048
  openssl req -new -key apiserver.key -subj "/CN=system:kube-apiserver" -out apiserver.csr -config openssl.cnf
  openssl x509 -req -in apiserver.csr -CA ca.crt -CAkey ca.key -out apiserver.crt -extensions v3_req -extfile openssl.cnf

  # inspect service logs to check certificate issues
  journalctl -u etcd.service -l
  kubectl logs etcd-master

  # when kube-apiserver is down
  docker ps -a
  docker logs <container-id>
#+end_src
