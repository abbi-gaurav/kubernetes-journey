  # install dirty cow to escape to the host

  # List iptable rules
  sudo iptables -L -t nat | grep kubernetes-dashboard

  # identifies db container
  sudo docker ps | grep db

  # execs into db container
  docker exec -it <container id> bash

  # connect to psql using DB username and password
#+end_src
